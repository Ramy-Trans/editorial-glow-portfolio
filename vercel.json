{
  "buildCommand": "bun install && bun run build",
  "outputDirectory": ".output/public",
  "installCommand": "bun install",
  "framework": null,
  "env": {
    "NITRO_PRESET": "vercel"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.(webp|jpg|jpeg|png|mp4|webm))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
